        <calculation class='tableau' formula='IF [LeadTimeDays] &lt;= 7 THEN &quot;0–7 Days&quot;&#10;&#10;ELSEIF [LeadTimeDays] &lt;= 14 THEN &quot;8–14 Days&quot;&#10;&#10;ELSEIF [LeadTimeDays] &lt;= 21 THEN &quot;15–21 Days&quot;&#10;&#10;ELSEIF [LeadTimeDays] &lt;= 30 THEN &quot;22–30 Days&quot;&#10;&#10;ELSEIF [LeadTimeDays] &lt;= 45 THEN &quot;31–45 Days&quot;&#10;&#10;ELSE &quot;46–60 Days&quot;&#10;&#10;END' />
      </column>
      <column caption='SMS Impact' datatype='real' name='[Calculation_2546556659949572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [SMS_Received] = 1 THEN [Calculation_6146147268292608] END)&#10;-&#10;AVG(IF [SMS_Received] = 0 THEN [Calculation_6146147268292608] END)' />
      </column>
      <column caption='SMS STATUS' datatype='string' name='[Calculation_2620911249813504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SMS_Received] = 1 THEN&#10;    &quot;SMS Received&quot;&#10;ELSE&#10;    &quot;No SMS&quot;&#10;END' />
      </column>
      <column caption='Distance Category' datatype='string' name='[Calculation_2620911289036801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DistanceToHospital_km] &lt; 5 THEN &quot;&lt;5 km&quot;&#10;ELSEIF [DistanceToHospital_km] &lt; 10 THEN &quot;5–10 km&quot;&#10;ELSEIF [DistanceToHospital_km] &lt; 20 THEN &quot;10–20 km&quot;&#10;ELSE &quot;&gt;20 km&quot;&#10;END' />
      </column>
      <column caption='Transport Category' datatype='string' name='[Calculation_2620911293538306]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TransportMode] = &quot;Walking&quot;&#10;THEN &quot;Walking&quot;&#10;&#10;ELSEIF [TransportMode] = &quot;Bus&quot;&#10;OR [TransportMode] = &quot;Rickshaw&quot;&#10;OR [TransportMode] = &quot;Taxi&quot;&#10;THEN &quot;Public&quot;&#10;&#10;ELSE&#10;&quot;Private&quot;&#10;END' />
      </column>
      <column caption='SMS satus' datatype='string' name='[Calculation_2620911312728067]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SMS_Received] = 1 THEN&#10;    &quot;Received&quot;&#10;ELSE&#10;    &quot;Not Received&quot;&#10;END' />
      </column>
      <column caption='No Show Flag' datatype='integer' name='[Calculation_2692929436024832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [No_Show] = &quot;Yes&quot; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Prev No-Show ' datatype='string' name='[Calculation_2865003235577857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PreviousNoShows] = 0 THEN &quot;0&quot;&#10;&#10;ELSEIF [PreviousNoShows] = 1 THEN &quot;1&quot;&#10;&#10;ELSE&#10;&#10;&quot;2+&quot;&#10;&#10;END' />
      </column>
      <column caption='Reasons of Missed' datatype='string' name='[Calculation_2865003267502083]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NoShowReason] = &quot;Forgot&quot;&#10;OR [NoShowReason] = &quot;Work Conflict&quot;&#10;OR [NoShowReason] = &quot;Family Emergency&quot;&#10;THEN &quot;Personal Factors&quot;&#10;&#10;ELSEIF [NoShowReason] = &quot;Long Wait Time&quot;&#10;OR [NoShowReason] = &quot;Felt Better&quot;&#10;THEN &quot;Healthcare Experience&quot;&#10;&#10;ELSEIF [NoShowReason] = &quot;Transportation Issue&quot;&#10;THEN &quot;Transportation Barrier&quot;&#10;&#10;ELSEIF [NoShowReason] = &quot;Financial Constraint&quot;&#10;THEN &quot;Financial Barrier&quot;&#10;&#10;ELSE&#10;&quot;Unknown&quot;&#10;&#10;END' />
      </column>
      <column caption='Highlight Highest' datatype='string' name='[Calculation_3076934604673024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [AppointmentType] = &quot;Lab Review&quot; THEN&#10;    &quot;Highest&quot;&#10;ELSE&#10;    &quot;Other&quot;&#10;END' />
      </column>
      <column caption='No-Show Rate' datatype='real' default-format='p0.0%' name='[Calculation_6146147268292608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [No_Show] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNT([No_Show])' />
