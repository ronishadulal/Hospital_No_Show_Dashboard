          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Patients Scheduled More Than 15 Days Ahead Show Higher No-Show Rates</run>
          </formatted-text>
        </title>
      </layout-options>
